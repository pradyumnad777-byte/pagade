rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 3. Entity Validation Blueprint for PlayerProgress
    function isValidPlayerProgress(data) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'provider',
          'highestUnlockedLevel',
          'totalWins',
          'totalCaptures',
          'gloryPoints',
          'selectedDifficulty',
          'gameMode',
          'autoMoveSingle',
          'fastSpeed',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'provider',
          'highestUnlockedLevel',
          'totalWins',
          'totalCaptures',
          'gloryPoints',
          'selectedDifficulty',
          'gameMode',
          'autoMoveSingle',
          'fastSpeed',
          'createdAt',
          'updatedAt'
        ])
        && data.uid == request.auth.uid
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 80
        && data.provider is string
        && data.provider.size() <= 16
        && data.provider in ['google', 'apple']
        && data.highestUnlockedLevel is int
        && data.highestUnlockedLevel >= 1
        && data.highestUnlockedLevel <= 100000
        && data.totalWins is int
        && data.totalWins >= 0
        && data.totalWins <= 100000000
        && data.totalCaptures is int
        && data.totalCaptures >= 0
        && data.totalCaptures <= 100000000
        && data.gloryPoints is int
        && data.gloryPoints >= 0
        && data.gloryPoints <= 100000000
        && data.selectedDifficulty is string
        && data.selectedDifficulty.size() <= 20
        && data.selectedDifficulty in [
          'auto',
          'beginner',
          'intermediate',
          'advanced',
          'semi-pro',
          'pro',
          'super-pro',
          'undisputed'
        ]
        && data.gameMode is string
        && data.gameMode.size() <= 20
        && data.gameMode in ['classic', 'quick_blitz']
        && data.autoMoveSingle is bool
        && data.fastSpeed is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 4. Collection Rules: /players/{userId}
    match /players/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidPlayerProgress(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidPlayerProgress(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Sync Progress & Preferences
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName',
            'provider',
            'highestUnlockedLevel',
            'totalWins',
            'totalCaptures',
            'gloryPoints',
            'selectedDifficulty',
            'gameMode',
            'autoMoveSingle',
            'fastSpeed',
            'updatedAt'
          ])
        );

      allow delete: if false;
    }
  }
}
