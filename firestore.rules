rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Primitives & Admin RBAC
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Bootstrapped Super-Admin (pradyumnad777@gmail.com)
    function isSuperAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'pradyumnad777@gmail.com';
    }

    // Delegated Admin check: either Super-Admin or has a document in /admins/{uid}
    function isAdmin() {
      return isSuperAdmin() || (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // 3. Entity Validation Blueprint for PlayerProgress
    function isValidPlayerProgress(data) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'provider',
          'highestUnlockedLevel',
          'totalWins',
          'totalCaptures',
          'gloryPoints',
          'selectedDifficulty',
          'gameMode',
          'autoMoveSingle',
          'fastSpeed',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'provider',
          'highestUnlockedLevel',
          'totalWins',
          'totalCaptures',
          'gloryPoints',
          'selectedDifficulty',
          'gameMode',
          'autoMoveSingle',
          'fastSpeed',
          'createdAt',
          'updatedAt'
        ])
        && data.uid == request.auth.uid
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 80
        && data.provider is string
        && data.provider.size() <= 16
        && data.provider in ['google', 'apple']
        && data.highestUnlockedLevel is int
        && data.highestUnlockedLevel >= 1
        && data.highestUnlockedLevel <= 100000
        && data.totalWins is int
        && data.totalWins >= 0
        && data.totalWins <= 100000000
        && data.totalCaptures is int
        && data.totalCaptures >= 0
        && data.totalCaptures <= 100000000
        && data.gloryPoints is int
        && data.gloryPoints >= 0
        && data.gloryPoints <= 100000000
        && data.selectedDifficulty is string
        && data.selectedDifficulty.size() <= 20
        && data.selectedDifficulty in [
          'auto',
          'beginner',
          'intermediate',
          'advanced',
          'semi-pro',
          'pro',
          'super-pro',
          'undisputed'
        ]
        && data.gameMode is string
        && data.gameMode.size() <= 20
        && data.gameMode in ['classic', 'quick_blitz']
        && data.autoMoveSingle is bool
        && data.fastSpeed is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 4. Entity Validation Blueprint for AdminGrant (/admin_emails/{emailId})
    function isValidAdminGrant(data) {
      return data.keys().hasAll(['email', 'role', 'addedBy', 'createdAt'])
        && data.keys().hasOnly(['email', 'role', 'addedBy', 'createdAt'])
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 120
        && data.role is string
        && data.role in ['owner', 'admin']
        && data.addedBy is string
        && data.addedBy.size() >= 3
        && data.addedBy.size() <= 120
        && data.createdAt is timestamp;
    }

    // 5. Collection Rules: /players/{userId}
    match /players/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if false;

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidPlayerProgress(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidPlayerProgress(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() || (
            request.auth.uid == userId
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName',
              'provider',
              'highestUnlockedLevel',
              'totalWins',
              'totalCaptures',
              'gloryPoints',
              'selectedDifficulty',
              'gameMode',
              'autoMoveSingle',
              'fastSpeed',
              'updatedAt'
            ])
          )
        );

      allow delete: if false;
    }

    // 6. Collection Rules: /admin_emails/{emailId}
    match /admin_emails/{emailId} {
      allow get: if isVerifiedUser() && isValidId(emailId) && (isAdmin() || resource.data.email == request.auth.token.email);
      allow list: if isAdmin() && resource.data.role in ['owner', 'admin'];

      allow create: if isAdmin()
        && isValidId(emailId)
        && isValidAdminGrant(incoming())
        && incoming().createdAt == request.time;

      allow update: if isAdmin()
        && isValidId(emailId)
        && isValidAdminGrant(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['role']);

      allow delete: if isSuperAdmin() && isValidId(emailId);
    }
  }
}
